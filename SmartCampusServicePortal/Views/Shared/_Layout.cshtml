<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Smart Campus Service Portal</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="bg-light d-flex flex-column min-vh-100">
    <!-- Main Navigation Bar -->
    <header>
        <nav class="navbar navbar-expand-lg navbar-dark bg-primary shadow-sm">
            <div class="container">
                <a class="navbar-brand fw-bold d-flex align-items-center" asp-controller="Home" asp-action="Index">
                    <i class="bi bi-mortarboard-fill me-2 fs-4"></i>
                    <span>Smart Campus Portal</span>
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarContent"
                        aria-controls="navbarContent" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="navbarContent">
                    <ul class="navbar-nav me-auto mb-2 mb-lg-0">
                        <li class="nav-item">
                            <a class="nav-link text-white" asp-controller="Home" asp-action="Index">
                                <i class="bi bi-speedometer2 me-1"></i> Dashboard
                            </a>
                        </li>
                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle text-white" href="#" id="servicesDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                <i class="bi bi-tools me-1"></i> Service Requests
                            </a>
                            <ul class="dropdown-menu" aria-labelledby="servicesDropdown">
                                <li>
                                    <a class="dropdown-item" asp-controller="ServiceRequests" asp-action="Create">
                                        <i class="bi bi-plus-circle text-primary me-2"></i> Submit Request
                                    </a>
                                </li>
                                <li>
                                    <a class="dropdown-item" asp-controller="ServiceRequests" asp-action="Index">
                                        <i class="bi bi-list-check text-primary me-2"></i> View All Requests
                                    </a>
                                </li>
                                <li>
                                    <a class="dropdown-item" asp-controller="ServiceRequests" asp-action="Track">
                                        <i class="bi bi-search text-primary me-2"></i> Track Request Status
                                    </a>
                                </li>
                            </ul>
                        </li>
                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle text-white" href="#" id="studentsDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                <i class="bi bi-people me-1"></i> Students
                            </a>
                            <ul class="dropdown-menu" aria-labelledby="studentsDropdown">
                                <li>
                                    <a class="dropdown-item" asp-controller="Students" asp-action="Register">
                                        <i class="bi bi-person-plus text-primary me-2"></i> Student Registration
                                    </a>
                                </li>
                                <li>
                                    <a class="dropdown-item" asp-controller="Students" asp-action="Index">
                                        <i class="bi bi-person-lines-fill text-primary me-2"></i> Student Directory
                                    </a>
                                </li>
                                <li>
                                    <a class="dropdown-item" asp-controller="Students" asp-action="Dashboard">
                                        <i class="bi bi-person-badge text-primary me-2"></i> Student Dashboard
                                    </a>
                                </li>
                            </ul>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-white" asp-controller="Admin" asp-action="Index">
                                <i class="bi bi-shield-lock me-1"></i> Admin Panel
                            </a>
                        </li>
                    </ul>

                    <div class="d-flex align-items-center">
                        <a href="/api/servicerequests" target="_blank" class="btn btn-sm btn-outline-light me-2" title="Direct JSON REST API">
                            <i class="bi bi-code-slash me-1"></i> REST API (JSON)
                        </a>
                        <a class="btn btn-sm btn-light text-primary fw-semibold" asp-controller="ServiceRequests" asp-action="Create">
                            <i class="bi bi-plus-lg me-1"></i> New Request
                        </a>
                    </div>
                </div>
            </div>
        </nav>
    </header>

    <!-- Page Content Container -->
    <div class="container my-4 flex-grow-1">
        <!-- Success Alert Message -->
        @if (TempData["SuccessMessage"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show shadow-sm" role="alert">
                <i class="bi bi-check-circle-fill me-2"></i>
                @TempData["SuccessMessage"]
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }

        <!-- Error Alert Message -->
        @if (TempData["ErrorMessage"] != null)
        {
            <div class="alert alert-danger alert-dismissible fade show shadow-sm" role="alert">
                <i class="bi bi-exclamation-triangle-fill me-2"></i>
                @TempData["ErrorMessage"]
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }

        <main role="main">
            @RenderBody()
        </main>
    </div>

    <!-- Clean Footer -->
    <footer class="footer bg-white border-top py-3 mt-auto text-muted">
        <div class="container text-center text-md-start d-flex flex-column flex-md-row justify-content-between align-items-center">
            <span>&copy; 2026 Smart Campus Service Portal - ASP.NET Core MVC Practical Project</span>
            <span>
                <span class="badge bg-success-subtle text-success border border-success me-2">
                    <i class="bi bi-database me-1"></i> SQL Server LocalDB
                </span>
                <span class="badge bg-primary-subtle text-primary border border-primary">
                    <i class="bi bi-globe me-1"></i> Web API Integrated
                </span>
            </span>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
