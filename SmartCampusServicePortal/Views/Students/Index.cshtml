@model IEnumerable<SmartCampusServicePortal.Models.Student>
@{
    ViewData["Title"] = "Student Directory";
}

<div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center pb-3 mb-4 border-bottom">
    <div>
        <h2 class="h3 fw-bold text-dark mb-1">Student Directory</h2>
        <p class="text-muted mb-0">List of all registered campus students</p>
    </div>
    <div class="mt-3 mt-md-0">
        <a asp-action="Register" class="btn btn-primary">
            <i class="bi bi-person-plus me-1"></i> Register New Student
        </a>
    </div>
</div>

<div class="card border-0 shadow-sm">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Roll / Student ID</th>
                        <th>Full Name</th>
                        <th>Department</th>
                        <th>Email</th>
                        <th>Phone</th>
                        <th>Registered Date</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        @foreach (var student in Model)
                        {
                            <tr>
                                <td class="fw-bold text-primary">@student.StudentIdNumber</td>
                                <td class="fw-medium">@student.FullName</td>
                                <td>
                                    <span class="badge bg-secondary bg-opacity-10 text-secondary border">
                                        @student.Department
                                    </span>
                                </td>
                                <td>@student.Email</td>
                                <td>@student.PhoneNumber</td>
                                <td class="text-muted small">@student.RegisteredDate.ToString("dd MMM yyyy")</td>
                                <td class="text-end">
                                    <a asp-action="Details" asp-route-id="@student.Id" class="btn btn-sm btn-outline-info me-1">
                                        <i class="bi bi-eye me-1"></i> Profile
                                    </a>
                                    <a asp-action="Dashboard" asp-route-rollNo="@student.StudentIdNumber" class="btn btn-sm btn-outline-primary">
                                        <i class="bi bi-speedometer2 me-1"></i> Portal
                                    </a>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="7" class="text-center py-4 text-muted">
                                No students registered yet. Click "Register New Student" to add one.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
