@model SmartCampusServicePortal.Models.Student
@{
    ViewData["Title"] = "Student Profile";
    var requests = ViewBag.Requests as List<SmartCampusServicePortal.Models.ServiceRequest> ?? new List<SmartCampusServicePortal.Models.ServiceRequest>();
}

<div class="d-flex justify-content-between align-items-center pb-3 mb-4 border-bottom">
    <div>
        <h2 class="h3 fw-bold text-dark mb-1">Student Profile</h2>
        <p class="text-muted mb-0">Detailed view of registered student and their service history</p>
    </div>
    <div>
        <a asp-action="Index" class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left me-1"></i> Back to Directory
        </a>
    </div>
</div>

<div class="row g-4">
    <!-- Student Information Card -->
    <div class="col-12 col-lg-4">
        <div class="card border-0 shadow-sm">
            <div class="card-header bg-primary text-white py-3">
                <h5 class="fw-bold mb-0">
                    <i class="bi bi-person-badge-fill me-2"></i>@Model.FullName
                </h5>
            </div>
            <div class="card-body">
                <dl class="row mb-0">
                    <dt class="col-sm-5 text-muted">Roll / ID:</dt>
                    <dd class="col-sm-7 fw-bold text-primary">@Model.StudentIdNumber</dd>

                    <dt class="col-sm-5 text-muted">Department:</dt>
                    <dd class="col-sm-7">@Model.Department</dd>

                    <dt class="col-sm-5 text-muted">Email:</dt>
                    <dd class="col-sm-7"><a href="mailto:@Model.Email" class="text-decoration-none">@Model.Email</a></dd>

                    <dt class="col-sm-5 text-muted">Phone:</dt>
                    <dd class="col-sm-7">@Model.PhoneNumber</dd>

                    <dt class="col-sm-5 text-muted">Registered:</dt>
                    <dd class="col-sm-7">@Model.RegisteredDate.ToString("dd MMM yyyy, hh:mm tt")</dd>
                </dl>
            </div>
            <div class="card-footer bg-white border-top">
                <a asp-controller="ServiceRequests" asp-action="Create" class="btn btn-sm btn-primary w-100">
                    <i class="bi bi-plus-circle me-1"></i> Submit Request For This Student
                </a>
            </div>
        </div>
    </div>

    <!-- Student's Service Requests -->
    <div class="col-12 col-lg-8">
        <div class="card border-0 shadow-sm">
            <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center">
                <h5 class="fw-bold mb-0 text-dark">
                    <i class="bi bi-tools me-2 text-primary"></i>Service Requests History
                </h5>
                <span class="badge bg-secondary">Total: @requests.Count</span>
            </div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>ID</th>
                                <th>Category</th>
                                <th>Description</th>
                                <th>Date</th>
                                <th>Status</th>
                                <th class="text-end">Action</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (requests.Any())
                            {
                                @foreach (var req in requests)
                                {
                                    <tr>
                                        <td class="fw-semibold">#@req.Id</td>
                                        <td><span class="badge bg-light text-dark border">@req.Category</span></td>
                                        <td>
                                            <span class="d-inline-block text-truncate" style="max-width: 240px;">
                                                @req.Description
                                            </span>
                                        </td>
                                        <td class="small text-muted">@req.SubmissionDate.ToString("dd MMM yyyy")</td>
                                        <td>
                                            @if (req.Status == "Pending")
                                            {
                                                <span class="badge bg-warning text-dark">Pending</span>
                                            }
                                            else if (req.Status == "In Progress")
                                            {
                                                <span class="badge bg-primary">In Progress</span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-success">Completed</span>
                                            }
                                        </td>
                                        <td class="text-end">
                                            <a asp-controller="ServiceRequests" asp-action="Details" asp-route-id="@req.Id" class="btn btn-sm btn-outline-secondary">
                                                View
                                            </a>
                                        </td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="6" class="text-center py-4 text-muted">
                                        No service requests submitted by this student yet.
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>
