@model List<SmartCampusServicePortal.Models.ServiceRequest>
@{
    ViewData["Title"] = "Student Portal Dashboard";
    var student = ViewBag.Student as SmartCampusServicePortal.Models.Student;
}

<div class="pb-3 mb-4 border-bottom">
    <h2 class="h3 fw-bold text-dark mb-1">Student Portal Dashboard</h2>
    <p class="text-muted mb-0">Search and manage your individual service requests</p>
</div>

<!-- Search By Student Roll Number -->
<div class="card border-0 shadow-sm mb-4">
    <div class="card-body p-4">
        <form asp-action="Dashboard" method="get" class="row g-3 align-items-center">
            <div class="col-12 col-md-8">
                <label for="rollNo" class="form-label fw-semibold">Enter Your Student ID / Roll Number</label>
                <div class="input-group">
                    <span class="input-group-text bg-white"><i class="bi bi-person-badge"></i></span>
                    <input type="text" id="rollNo" name="rollNo" class="form-control" placeholder="e.g. STU101, STU102, STU103..." value="@Context.Request.Query["rollNo"]" required />
                </div>
            </div>
            <div class="col-12 col-md-4 d-flex align-items-end">
                <button type="submit" class="btn btn-primary w-100 py-2">
                    <i class="bi bi-search me-1"></i> Access Dashboard
                </button>
            </div>
        </form>
    </div>
</div>

@if (ViewBag.ErrorMessage != null)
{
    <div class="alert alert-warning shadow-sm">
        <i class="bi bi-exclamation-triangle-fill me-2"></i> @ViewBag.ErrorMessage
    </div>
}

@if (student != null)
{
    <!-- Student Info Summary Bar -->
    <div class="card border-0 shadow-sm mb-4 bg-primary text-white">
        <div class="card-body p-4 d-flex flex-column flex-md-row justify-content-between align-items-md-center">
            <div>
                <h4 class="fw-bold mb-1">Welcome, @student.FullName!</h4>
                <div class="opacity-75">
                    <span><i class="bi bi-card-text me-1"></i> Roll No: <strong>@student.StudentIdNumber</strong></span> |
                    <span><i class="bi bi-mortarboard me-1"></i> Department: <strong>@student.Department</strong></span> |
                    <span><i class="bi bi-envelope me-1"></i> @student.Email</span>
                </div>
            </div>
            <div class="mt-3 mt-md-0">
                <a asp-controller="ServiceRequests" asp-action="Create" class="btn btn-light text-primary fw-semibold">
                    <i class="bi bi-plus-circle me-1"></i> Submit New Request
                </a>
            </div>
        </div>
    </div>

    <!-- Student's Requests Table -->
    <div class="card border-0 shadow-sm">
        <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center">
            <h5 class="fw-bold mb-0 text-dark">
                <i class="bi bi-list-stars me-2 text-primary"></i>Your Submitted Requests
            </h5>
            <span class="badge bg-primary">Total: @(Model?.Count ?? 0)</span>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Ticket #</th>
                            <th>Category</th>
                            <th>Issue Description</th>
                            <th>Date Submitted</th>
                            <th>Status</th>
                            <th>Admin Remarks</th>
                            <th class="text-end">Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model != null && Model.Any())
                        {
                            @foreach (var item in Model)
                            {
                                <tr>
                                    <td class="fw-bold text-primary">#@item.Id</td>
                                    <td><span class="badge bg-light text-dark border">@item.Category</span></td>
                                    <td>@item.Description</td>
                                    <td class="text-muted small">@item.SubmissionDate.ToString("dd MMM yyyy, hh:mm tt")</td>
                                    <td>
                                        @if (item.Status == "Pending")
                                        {
                                            <span class="badge bg-warning text-dark"><i class="bi bi-hourglass me-1"></i>Pending</span>
                                        }
                                        else if (item.Status == "In Progress")
                                        {
                                            <span class="badge bg-primary"><i class="bi bi-gear me-1"></i>In Progress</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-success"><i class="bi bi-check-circle me-1"></i>Completed</span>
                                        }
                                    </td>
                                    <td class="text-muted small">
                                        @(string.IsNullOrEmpty(item.AdminRemarks) ? "—" : item.AdminRemarks)
                                    </td>
                                    <td class="text-end">
                                        <a asp-controller="ServiceRequests" asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-secondary">
                                            Details
                                        </a>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="7" class="text-center py-4 text-muted">
                                    You have not submitted any service requests yet.
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
}
