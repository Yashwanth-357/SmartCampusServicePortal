@model SmartCampusServicePortal.Models.ServiceRequest
@{
    ViewData["Title"] = "Service Request Details";
}

<div class="row justify-content-center">
    <div class="col-12 col-md-9 col-lg-8">
        <div class="card border-0 shadow-sm">
            <div class="card-header bg-white py-3 border-bottom d-flex justify-content-between align-items-center">
                <div>
                    <h4 class="fw-bold mb-0 text-dark">
                        <i class="bi bi-info-circle-fill me-2 text-primary"></i>Service Request #@Model.Id
                    </h4>
                    <small class="text-muted">Submitted on @Model.SubmissionDate.ToString("dd MMMM yyyy, hh:mm tt")</small>
                </div>
                <div>
                    @if (Model.Status == "Pending")
                    {
                        <span class="badge bg-warning text-dark fs-6 px-3 py-2"><i class="bi bi-hourglass me-1"></i>Pending</span>
                    }
                    else if (Model.Status == "In Progress")
                    {
                        <span class="badge bg-primary fs-6 px-3 py-2"><i class="bi bi-arrow-repeat me-1"></i>In Progress</span>
                    }
                    else
                    {
                        <span class="badge bg-success fs-6 px-3 py-2"><i class="bi bi-check2-circle me-1"></i>Completed</span>
                    }
                </div>
            </div>
            <div class="card-body p-4">
                <dl class="row mb-0">
                    <dt class="col-sm-4 text-muted mb-3">Student Name:</dt>
                    <dd class="col-sm-8 fw-semibold mb-3">@Model.StudentName</dd>

                    <dt class="col-sm-4 text-muted mb-3">Roll Number:</dt>
                    <dd class="col-sm-8 mb-3">@(string.IsNullOrEmpty(Model.StudentRollNo) ? "N/A" : Model.StudentRollNo)</dd>

                    <dt class="col-sm-4 text-muted mb-3">Service Category:</dt>
                    <dd class="col-sm-8 mb-3">
                        <span class="badge bg-light text-dark border fs-6">@Model.Category</span>
                    </dd>

                    <dt class="col-sm-4 text-muted mb-3">Issue Description:</dt>
                    <dd class="col-sm-8 mb-3">
                        <div class="p-3 bg-light rounded border text-secondary">
                            @Model.Description
                        </div>
                    </dd>

                    <dt class="col-sm-4 text-muted mb-3">Status:</dt>
                    <dd class="col-sm-8 mb-3 fw-bold">@Model.Status</dd>

                    <dt class="col-sm-4 text-muted mb-3">Admin Remarks:</dt>
                    <dd class="col-sm-8 mb-3">
                        @if (!string.IsNullOrEmpty(Model.AdminRemarks))
                        {
                            <div class="alert alert-info py-2 px-3 mb-0">
                                <i class="bi bi-chat-left-text me-2"></i>@Model.AdminRemarks
                            </div>
                        }
                        else
                        {
                            <span class="text-muted fst-italic">No remarks entered yet.</span>
                        }
                    </dd>
                </dl>
            </div>
            <div class="card-footer bg-white border-top p-3 d-flex justify-content-between align-items-center">
                <a asp-action="Index" class="btn btn-outline-secondary">
                    <i class="bi bi-arrow-left me-1"></i> Back to Requests
                </a>
                <div class="d-flex gap-2">
                    <a asp-controller="Admin" asp-action="UpdateStatus" asp-route-id="@Model.Id" class="btn btn-outline-warning">
                        <i class="bi bi-arrow-repeat me-1"></i> Update Status
                    </a>
                    <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary">
                        <i class="bi bi-pencil me-1"></i> Edit Request
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>
